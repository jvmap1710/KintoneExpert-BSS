{
  "name": "kintone-expert-bss",
  "version": "1.0.23-beta.3",
  "description": "KE Kit for running a Kintone expert team in Codex",
  "bin": {
    "kintone-expert-bss": "dist/ke-installer.mjs",
    "ke": "dist/ke-installer.mjs"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build-npm-kit.mjs",
    "prepare": "npm run build",
    "prepack": "npm run build && npm run validate && npm test",
    "dev:install": "npm --prefix platform/ke-kintone-mcp ci && npm --prefix platform/ke-browser-mcp ci && npm --prefix platform/ke-office-cli ci",
    "setup": "node scripts/setup.mjs",
    "validate": "node scripts/validate-kit.mjs",
    "test": "npm run test:flow && npm run test:installer-hardening && npm run test:setup && npm run test:state && npm run eval:contract && npm run test:runtime",
    "pretest:flow": "npm run build",
    "test:flow": "node scripts/test-kit-flow.mjs",
    "test:installer-hardening": "node scripts/test-installer-hardening.mjs",
    "test:setup": "node scripts/test-setup-onboarding.mjs",
    "test:state": "node scripts/test-project-hardening.mjs",
    "test:runtime": "npm --prefix platform/ke-kintone-mcp run test:runtime",
    "eval:contract": "node scripts/eval-router-contract.mjs",
    "eval:agent:live": "node scripts/eval-agent-live.mjs",
    "e2e:live": "node scripts/run-live-e2e.mjs",
    "project": "node scripts/ke-project.mjs",
    "migrate": "node scripts/migrate-projects.mjs",
    "pack:check": "npm pack --dry-run",
    "kintone:check": "npm --prefix platform/ke-kintone-mcp run check",
    "kintone:test": "npm --prefix platform/ke-kintone-mcp run test:connection",
    "mcp:kintone": "npm --prefix platform/ke-kintone-mcp run mcp:kintone",
    "mcp:playwright": "npm --prefix platform/ke-browser-mcp run mcp:playwright",
    "mcp:chrome-devtools": "npm --prefix platform/ke-browser-mcp run mcp:chrome-devtools",
    "office": "npm --prefix platform/ke-office-cli run office --",
    "office:check": "npm --prefix platform/ke-office-cli run check",
    "init": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/init-customer-project.ps1",
    "doctor": "npm --prefix platform/ke-kintone-mcp run check"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jvmap1710/KintoneExpert-BSS.git"
  },
  "homepage": "https://github.com/jvmap1710/KintoneExpert-BSS#readme",
  "bugs": {
    "url": "https://github.com/jvmap1710/KintoneExpert-BSS/issues"
  },
  "keywords": [
    "kintone",
    "codex",
    "mcp",
    "ai-agents",
    "presales"
  ]
}
