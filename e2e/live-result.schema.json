{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "summary", "cases", "limitations"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["PASS", "FAIL", "BLOCKED"]
    },
    "summary": {"type": "string"},
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "actual", "evidence"],
        "properties": {
          "id": {"type": "string"},
          "status": {
            "type": "string",
            "enum": ["PASS", "FAIL", "BLOCKED", "NOT_RUN"]
          },
          "actual": {"type": "string"},
          "evidence": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}
