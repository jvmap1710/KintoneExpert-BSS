# Required
KINTONE_BASE_URL=https://your-subdomain.cybozu.com

# Choose ONE authentication method.
# Method 1: username/password (recommended when Codex must create apps,
# change app settings, and deploy settings)
KINTONE_USERNAME=
KINTONE_PASSWORD=

# Method 2: API token(s), comma-separated, maximum 9.
# API tokens are limited by the permissions and apps assigned to them.
# KINTONE_API_TOKEN=

# Optional: basic authentication in front of Kintone
# KINTONE_BASIC_AUTH_USERNAME=
# KINTONE_BASIC_AUTH_PASSWORD=

# Optional: HTTPS proxy
# HTTPS_PROXY=http://proxy.example.com:8080

# Downloaded attachments are stored here.
KINTONE_ATTACHMENTS_DIR=attachments

